# WebKitGTK probe runner — the engine `entity-browser-rust`'s Tauri desktop path
# ships on, and the one our Firefox-only measurements never covered.
#
# Stock Debian packages only, per the ecosystem's minimal-dependency posture: the
# distro's WebKitGTK is the point, not a bespoke build. Whatever WebRTC support
# this image has is what a Tauri user on this distro generation gets, which is
# exactly the question being asked.
FROM debian:bookworm-slim

# webkit2gtk-4.1 is what Tauri 2 links (entity-browser-rust's Dockerfile), so the
# probe runs against the same generation the desktop app does. python3-gi is the
# harness; xvfb because WebKitGTK wants a display server even when nothing is
# looked at; the fonts/dbus bits are what a WebView needs before it will render
# at all rather than fail in a way that reads like an engine verdict.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-gi \
        gir1.2-webkit2-4.1 \
        libwebkit2gtk-4.1-0 \
        xvfb \
        dbus-x11 \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-nice \
        libnice10 \
        fonts-dejavu-core \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# WebKitGTK's sandbox and DMA-BUF renderer both assume host facilities a
# container does not have; without these it dies in ways that look like an
# engine failure and are not. Set here rather than in the harness so the harness
# stays a plain script anyone can run on a desktop.
ENV WEBKIT_DISABLE_DMABUF_RENDERER=1 \
    WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 \
    WEBKIT_DISABLE_COMPOSITING_MODE=1 \
    GDK_BACKEND=x11 \
    DISPLAY=:99 \
    PYTHONUNBUFFERED=1

WORKDIR /probes

# Xvfb is started DIRECTLY, not via `xvfb-run`. Debian's xvfb-run waits for the
# display by polling `xdpyinfo`, which lives in x11-utils; without that package
# the wait loop never succeeds and the harness is never executed at all. The
# container then sits with Xvfb up and no python process — which reads like a
# hung probe rather than a missing dependency, and cost a 35-minute stare.
# Waiting on the X socket instead needs nothing beyond Xvfb itself.
#
# `dbus-run-session` because WebKitGTK's network and web processes expect a
# session bus and misbehave without one.
ENTRYPOINT ["/bin/sh", "-c", "Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp >/dev/null 2>&1 & for _ in $(seq 1 100); do [ -e /tmp/.X11-unix/X99 ] && break; sleep 0.1; done; exec dbus-run-session -- python3 /probes/webkit-harness.py \"$@\"", "--"]
CMD ["rtc-loopback-datachannel.html"]
